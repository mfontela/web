geom_rect(aes(xmin = as.POSIXct("2023-10-31"), xmax = (max(df_cumulative$date)+days(17)), ymin = -Inf, ymax = Inf),
fill = "#de2d26", alpha = 0.3) +
# Línea y puntos de "total_papers"
geom_line(data = df_cumulative, aes(x = date, y = total_papers, color = "Total Papers"), size = 1.2) +
geom_point(data = df_cumulative, aes(x = date, y = total_papers, color = "Total Papers"), size = 4, alpha = 0.8) +
# Línea y puntos de "first_author_papers"
geom_line(data = df_cumulative, aes(x = date, y = first_author_papers, color = "First Author Papers"), size = 1.2) +
geom_point(data = df_cumulative, aes(x = date, y = first_author_papers, color = "First Author Papers"), size = 4, alpha = 0.8) +
# Línea y puntos de "no_fiz_papers" (con filtro)
geom_line(data = df_cumulative %>% filter(no_fiz_papers >= 1), aes(x = date, y = no_fiz_papers, color = "Without Fiz"), size = 1.2) +
geom_point(data = df_cumulative %>% filter(no_fiz_papers >= 1), aes(x = date, y = no_fiz_papers, color = "Without Fiz"), size = 4, alpha = 0.8) +
# Línea y puntos para "total_projects" en df_cumulative_project con línea punteada
geom_line(data = df_cumulative_project, aes(x = date, y = total_projects, color = "Total Projects"),
linetype = "dashed", size = 1.2) +  # Línea punteada (puedes cambiar "dashed" por "dotted", "solid" u otros)
geom_point(data = df_cumulative_project, aes(x = date, y = total_projects, color = "Total Projects"),
size = 5, shape = 17, alpha = 0.8) +  # Cambié el shape de los puntos a triángulos (shape = 17)
# Personalización de colores
scale_color_manual(
values = c(
"Total Papers" = "#1b9e77",
"First Author Papers" = "#d95f02",
"Without Fiz" = "#7570b3",
"Total Projects" = "#e7298a"  # Color para la nueva línea
)
) +
# Configuración del eje X con etiquetas cada año
scale_x_datetime(
date_breaks = "1 year",  # Etiquetas cada año
date_labels = "%Y",  # Formato de año completo (e.g., 2023)
limits = c(as.POSIXct("2015-09-01"), (max(df_cumulative$date)+days(17))),  # Definir el límite inferior
expand = c(0, 0.5)  # Evitar espacio adicional al principio
) +
scale_y_continuous(
breaks = c(1, 5, 10, 15, 20, 25),  # Etiquetas específicas del eje Y
labels = c("1", "5", "10", "15", "20", "25")  # Etiquetas visibles
) +
labs(
title = "Marcos Fontela - cumulative research outputs over time",  # Título con solo la primera palabra en mayúscula
x = "Year",
y = "Number"
) +
theme_minimal() +
theme(
legend.position = "none",  # Eliminar leyenda
plot.title = element_text(hjust = 0.5, size = 16),  # Centrar y aumentar título
axis.title = element_text(size = 14),  # Aumentar tamaño de títulos de ejes
axis.text = element_text(size = 12))  # Aumentar tamaño de texto de ejes
#AIM: eje X el tiempo, eje Y el acumulado de: papers totales, como primer autor y sin Fiz
library(dplyr)
library(ggplot2)
# Filtrar y calcular valores acumulados
df_cumulative <- df %>%
filter(type == "paper", status == "YEAH!") %>% # Filtrar solo los registros de interés
arrange(date) %>% # Asegurar que los datos estén ordenados por fecha
mutate(
total_papers = cumsum(type == "paper"), # Acumulado total de papers
first_author_papers = cumsum(Main_author == 1), # Acumulado de primer autor
no_fiz_papers = cumsum(Without_Fiz == 1), # Acumulado sin Fiz
Main_author_no_fiz_papers = cumsum(Main_author == 1 & Without_Fiz == 1) # Acumulado sin Fiz
)
df_cumulative_project <- df %>%
filter(type == "project", status == "YEAH!") %>% # Filtrar solo los registros de interés
arrange(date) %>% # Asegurar que los datos estén ordenados por fecha
mutate(
total_projects = cumsum(type == "project"))
# Graficar
ggplot() +
# Áreas de color de fondo para los tramos temporales
geom_rect(aes(xmin = as.POSIXct("2015-04-01"), xmax = as.POSIXct("2018-03-10"), ymin = -Inf, ymax = Inf),
fill = "#fc9272", alpha = 0.3) +
geom_rect(aes(xmin = as.POSIXct("2018-03-10"), xmax = as.POSIXct("2019-12-01"), ymin = -Inf, ymax = Inf),
fill = "#de2d26", alpha = 0.3) +
geom_rect(aes(xmin = as.POSIXct("2019-12-01"), xmax = as.POSIXct("2021-10-30"), ymin = -Inf, ymax = Inf),
fill = "cyan4", alpha = 0.3) +
geom_rect(aes(xmin = as.POSIXct("2021-10-30"), xmax = as.POSIXct("2023-10-31"), ymin = -Inf, ymax = Inf),
fill = "royalblue4", alpha = 0.3) +
geom_rect(aes(xmin = as.POSIXct("2023-10-31"), xmax = (max(df_cumulative$date)+days(17)), ymin = -Inf, ymax = Inf),
fill = "#de2d26", alpha = 0.3) +
# Línea y puntos de "total_papers"
geom_line(data = df_cumulative, aes(x = date, y = total_papers, color = "Total Papers"), size = 1.2) +
geom_point(data = df_cumulative, aes(x = date, y = total_papers, color = "Total Papers"), size = 4, alpha = 0.8) +
# Línea y puntos de "first_author_papers"
geom_line(data = df_cumulative, aes(x = date, y = first_author_papers, color = "First Author Papers"), size = 1.2) +
geom_point(data = df_cumulative, aes(x = date, y = first_author_papers, color = "First Author Papers"), size = 4, alpha = 0.8) +
# Línea y puntos de "no_fiz_papers" (con filtro)
geom_line(data = df_cumulative %>% filter(no_fiz_papers >= 1), aes(x = date, y = no_fiz_papers, color = "Without Fiz"), size = 1.2) +
geom_point(data = df_cumulative %>% filter(no_fiz_papers >= 1), aes(x = date, y = no_fiz_papers, color = "Without Fiz"), size = 4, alpha = 0.8) +
# Línea y puntos para "total_projects" en df_cumulative_project con línea punteada
geom_line(data = df_cumulative_project, aes(x = date, y = total_projects, color = "Total Projects"),
linetype = "dashed", size = 1.2) +  # Línea punteada (puedes cambiar "dashed" por "dotted", "solid" u otros)
geom_point(data = df_cumulative_project, aes(x = date, y = total_projects, color = "Total Projects"),
size = 5, shape = 17, alpha = 0.8) +  # Cambié el shape de los puntos a triángulos (shape = 17)
# Personalización de colores
scale_color_manual(
values = c(
"Total Papers" = "#1b9e77",
"First Author Papers" = "#d95f02",
"Without Fiz" = "#7570b3",
"Total Projects" = "#e7298a"  # Color para la nueva línea
)
) +
# Configuración del eje X con etiquetas cada año
scale_x_datetime(
date_breaks = "1 year",  # Etiquetas cada año
date_labels = "%Y",  # Formato de año completo (e.g., 2023)
limits = c(as.POSIXct("2015-04-01"), (max(df_cumulative$date)+days(17))),  # Definir el límite inferior
expand = c(0, 0.5)  # Evitar espacio adicional al principio
) +
scale_y_continuous(
breaks = c(1, 5, 10, 15, 20, 25),  # Etiquetas específicas del eje Y
labels = c("1", "5", "10", "15", "20", "25")  # Etiquetas visibles
) +
labs(
title = "Marcos Fontela - cumulative research outputs over time",  # Título con solo la primera palabra en mayúscula
x = "Year",
y = "Number"
) +
theme_minimal() +
theme(
legend.position = "none",  # Eliminar leyenda
plot.title = element_text(hjust = 0.5, size = 16),  # Centrar y aumentar título
axis.title = element_text(size = 14),  # Aumentar tamaño de títulos de ejes
