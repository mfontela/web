expand = c(0, 0.5)  # Evitar espacio adicional al principio
) +
scale_y_continuous(
limits =c(1,25),
breaks = c(1, 5, 10, 15, 20, 25),  # Etiquetas específicas del eje Y
labels = c("1", "5", "10", "15", "20", "25")  # Etiquetas visibles
) +
labs(
